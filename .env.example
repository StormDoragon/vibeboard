# Local development works with no environment variables.
# Use the browser-facing origin for authentication callbacks and Stripe.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=
# DATABASE_URL=postgresql://user:password@host:5432/vibeboard
# VIBEBOARD_DATA_DIR=.vibeboard

# Email verification and magic links
# SMTP_URL=smtps://username:password@smtp.example.com:465
# EMAIL_FROM=VibeBoard <hello@example.com>

# OAuth providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# OpenAI-compatible Chat Completions endpoint for account check-ins
# AI_API_URL=
# AI_API_KEY=
# AI_MODEL=

# OpenAI-compatible multipart transcription endpoint
# TRANSCRIPTION_API_URL=
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-1

# Stripe recurring prices and webhook signing secret
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MONTHLY_PRICE_ID=
# STRIPE_YEARLY_PRICE_ID=
